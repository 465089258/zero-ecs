{
  "name": "@zero-ecs/math",
  "version": "0.1.0",
  "description": "GC-conscious ECS-native 2D and 3D mathematics for Zero ECS.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./2d": { "types": "./dist/2d.d.ts", "import": "./dist/2d.js" },
    "./3d": { "types": "./dist/3d.d.ts", "import": "./dist/3d.js" },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@zero-ecs/game": "^0.1.0"
  },
  "devDependencies": {
    "@zero-ecs/game": "0.1.0"
  },
  "scripts": {
    "build": "rslib --config rslib.config.ts",
    "typecheck": "npm run build -w @zero-ecs/game && tsc -p tsconfig.json --noEmit"
  }
}
