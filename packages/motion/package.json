{
  "name": "@zero-ecs/motion",
  "version": "0.1.0",
  "description": "Reusable ECS-native 2D and 3D motion systems for Zero ECS.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./3d": { "types": "./dist/3d.d.ts", "import": "./dist/3d.js" }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@zero-ecs/game": "^0.1.0",
    "@zero-ecs/math": "^0.1.0"
  },
  "devDependencies": {
    "@zero-ecs/game": "0.1.0",
    "@zero-ecs/math": "0.1.0"
  },
  "scripts": {
    "build": "rslib --config rslib.config.ts",
    "typecheck": "npm run build -w @zero-ecs/game && npm run build -w @zero-ecs/math && tsc -p tsconfig.json --noEmit"
  }
}
