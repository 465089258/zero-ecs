{
  "compilerOptions": {
    "lib": ["ES2015", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "stripInternal": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@zero-ecs/world": ["./packages/world/src/index.ts"],
      "@zero-ecs/world/advanced": ["./packages/world/src/advanced.ts"],
      "@zero-ecs/world/game-bridge": ["./packages/world/src/game-bridge.ts"],
      "@zero-ecs/scheduler": ["./packages/scheduler/src/index.ts"],
      "@zero-ecs/game": ["./packages/game/src/index.ts"],
      "@zero-ecs/game/advanced": ["./packages/game/src/advanced.ts"],
      "@zero-ecs/game/event": ["./packages/game/src/event.ts"],
      "@zero-ecs/game/time": ["./packages/game/src/time.ts"],
      "@zero-ecs/game/timer": ["./packages/game/src/timer.ts"],
      "@zero-ecs/game/random": ["./packages/game/src/random.ts"],
      "@zero-ecs/game/hierarchy": ["./packages/game/src/hierarchy.ts"],
      "@zero-ecs/game/pool": ["./packages/game/src/pool.ts"],
      "@zero-ecs/math": ["./packages/math/src/index.ts"],
      "@zero-ecs/math/2d": ["./packages/math/src/2d.ts"],
      "@zero-ecs/math/3d": ["./packages/math/src/3d.ts"],
      "@zero-ecs/math/projection": ["./packages/math/src/projection.ts"],
      "@zero-ecs/flying-sword": ["./packages/flying-sword/src/index.ts"],
      "@zero-ecs/flying-sword/integration": ["./packages/flying-sword/src/integration.ts"],
      "@zero-ecs/flying-sword/presentation": ["./packages/flying-sword/src/presentation.ts"]
    }
  }
}
